{
    "output": "HDMI-A-2",
    "layer": "top",
    "position": "top",
    "height": 34,
    "spacing": 4,

    "modules-left": ["niri/workspaces", "niri/window"],
    "modules-center": ["mpris", "clock"],
    "modules-right": ["pulseaudio", "network", "cpu", "memory", "temperature", "battery", "tray"],

    "niri/workspaces": {
        "format": "{index}",
        "active-only": false
    },

    "niri/window": {
        "format": "{title}",
        "max-length": 50,
        "separate-outputs": true
    },

    "mpris": {
        "format": "{player_icon} {dynamic}",
        "format-paused": "{status_icon} <i>{dynamic}</i>",
        "player-icons": {
            "default": "▶",
            "mpv": "🎵",
            "firefox": "🌎",
            "spotify": "🎧"
        },
        "status-icons": {
            "paused": "⏸"
        },
        "max-length": 40,
        "tooltip-format": "{player} - {title}\n{artist}\n{album}"
    },

    "clock": {
        "format": "{:%H:%M}",
        "format-alt": "{:%d.%m.%Y}",
        "tooltip-format": "{:%A, %B %d, %Y}"
    },

    "pulseaudio": {
        "format": " {volume}%",
        "format-muted": " muted",
        "on-click": "zephyr-osd-volume mute",
        "scroll-step": 2
    },

    "network": {
        "format-wifi": " {essid}",
        "format-ethernet": " eth",
        "format-disconnected": " offline",
        "tooltip-format": "{ifname} via {gwaddr}",
        "interval": 5
    },

    "cpu": {
        "format": " {usage}%",
        "interval": 2
    },

    "memory": {
        "format": " {percentage}%",
        "interval": 5
    },

    "temperature": {
        "format": " {temperatureC}°C",
        "critical-threshold": 80
    },

    "battery": {
        "format": " {capacity}%",
        "format-charging": " {capacity}%",
        "format-plugged": " {capacity}%",
        "states": {
            "warning": 20,
            "critical": 10
        }
    },

    "tray": {
        "icon-size": 16,
        "spacing": 8
    }
}
