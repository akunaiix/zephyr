#!/usr/bin/env bash
# Zephyr theme switcher.
set -euo pipefail

REPO_DIR="$HOME/projects/zephyr"
THEMES_DIR="$REPO_DIR/themes"
CONFIG_DIR="$REPO_DIR/config"

if [[ -z "${1:-}" ]] || [[ "$1" == "--list" ]]; then
    echo "Available themes:"
    ls -1 "$THEMES_DIR"
    echo ""
    echo "Usage: zephyr-theme <theme-name>"
    exit 1
fi

THEME_NAME="$1"
THEME_FILE="$THEMES_DIR/$THEME_NAME/colors.sh"

if [[ ! -f "$THEME_FILE" ]]; then
    echo "Error: theme '$THEME_NAME' not found."
    exit 1
fi

source "$THEME_FILE"

# 1. Waybar (colors.css)
cat > "$CONFIG_DIR/waybar/colors.css" <<EOF
/* Generated by zephyr-theme ($THEME_NAME) */
@define-color bg        $BG;
@define-color fg        $FG;
@define-color fg_dim    $FG_DIM;
@define-color surface0  $SURFACE0;
@define-color surface1  $SURFACE1;
@define-color accent    $ACCENT;
@define-color green     $GREEN;
@define-color yellow    $YELLOW;
@define-color red       $RED;
@define-color mauve     $MAUVE;
EOF

# 2. Fuzzel (fuzzel.ini)
sed -i "s/^background=.*/background=${BG#\#}ff/" "$CONFIG_DIR/fuzzel/fuzzel.ini"
sed -i "s/^text=.*/text=${FG#\#}ff/" "$CONFIG_DIR/fuzzel/fuzzel.ini"
sed -i "s/^match=.*/match=${ACCENT#\#}ff/" "$CONFIG_DIR/fuzzel/fuzzel.ini"
sed -i "s/^selection=.*/selection=${SURFACE0#\#}ff/" "$CONFIG_DIR/fuzzel/fuzzel.ini"
sed -i "s/^border=.*/border=${ACCENT#\#}ff/" "$CONFIG_DIR/fuzzel/fuzzel.ini"

# 3. Mako (mako.ini)
sed -i "s/^background-color=.*/background-color=$BG/" "$CONFIG_DIR/mako/mako.ini"
sed -i "s/^text-color=.*/text-color=$FG/" "$CONFIG_DIR/mako/mako.ini"
sed -i "s/^border-color=.*/border-color=$ACCENT/" "$CONFIG_DIR/mako/mako.ini"

# 4. Foot (foot.ini) - hex without '#'
sed -i "s/^background=.*/background=${BG#\#}/" "$CONFIG_DIR/foot/foot.ini"
sed -i "s/^foreground=.*/foreground=${FG#\#}/" "$CONFIG_DIR/foot/foot.ini"
sed -i "s/^regular4=.*/regular4=${ACCENT#\#}/" "$CONFIG_DIR/foot/foot.ini"

# 5. Gtklock (style.css)
sed -i "s/background-color: #[0-9a-fA-F]*;/background-color: $BG;/g" "$CONFIG_DIR/gtklock/style.css"
sed -i "s/color: #[0-9a-fA-F]*;/color: $FG;/g" "$CONFIG_DIR/gtklock/style.css"

echo "Theme applied: $THEME_NAME"

# Reload Waybar
if pgrep -x waybar > /dev/null; then
    pkill -x waybar || true
    sleep 0.5
    dbus-run-session -- waybar > /dev/null 2>&1 &
fi
